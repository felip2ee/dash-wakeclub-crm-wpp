# Wake Club · painel (WF-06)
#
# Copie este arquivo para `.env` e preencha. O `.env` é gitignored.
# Depois de preencher:
#
#     bun run db:apply    cria as roles limitadas e as views do painel
#     bun run db:check    confere views e privilégios das duas roles
#
# Solicite o host e as credenciais do banco ao responsável pela infraestrutura.


# ---------------------------------------------------------------------------
# A conexão da aplicação. Role SÓ LEITURA.
#
# Nunca use aqui o usuário dono do banco nem a credencial do n8n — aquelas
# escrevem. Cuidado também com o banco: `wakeclub` é o CRM; `n8n_queue` é o
# banco interno do n8n e não tem nada a ver com o painel.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://painel_ro:SENHA_DO_PAINEL@HOST:5432/wakeclub

# Segunda conexão da aplicação. Só alcança sessão, inscrição de push, log de
# toque e o carimbo de último acesso. A senha deve ser a mesma da variável
# PAINEL_RW_PASSWORD abaixo.
DATABASE_URL_RW=postgres://painel_rw:SENHA_LIMITADA_DO_PAINEL@HOST:5432/wakeclub


# ---------------------------------------------------------------------------
# As credenciais de setup abaixo são SÓ do scripts/painel-db.mjs.
# A aplicação nunca as lê — nenhum código em src/ referencia estas variáveis.
# ---------------------------------------------------------------------------

# Dono do banco. É quem tem direito de criar role e view.
ADMIN_DATABASE_URL=postgres://USUARIO_ADMIN:SENHA_ADMIN@HOST:5432/wakeclub

# Senha que a painel_ro vai passar a ter. Você inventa — mas tem que ser
# exatamente a mesma que está na DATABASE_URL lá em cima.
PAINEL_RO_PASSWORD=SENHA_DO_PAINEL

# Senha da role limitada de escrita do painel.
PAINEL_RW_PASSWORD=SENHA_LIMITADA_DO_PAINEL


# ---------------------------------------------------------------------------
# Web Push. Gere o par com: bunx web-push generate-vapid-keys --json
# A chave pública pode chegar ao navegador; as outras duas são server-only.
# ---------------------------------------------------------------------------
VITE_VAPID_PUBLIC_KEY=CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=CHAVE_PRIVADA_VAPID

# Segredo compartilhado entre o WF-09 e POST /api/push/enviar.
PUSH_DISPATCH_SECRET=SEGREDO_FORTE_DO_DISPATCH
