      "id": "3a123bf3-31eb-4257-b668-0cc9b3687548",
      "name": "Config da instancia",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -240,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with orfas as (\n  update wakeclub.mensagens\n     set transcricao_status = 'pendente'\n   where transcricao_status = 'transcrevendo'\n     and transcrito_em < now() - interval '15 minutes'\n  returning 1\n),\ndesistir as (\n  update wakeclub.mensagens\n     set transcricao_status = 'falhou',\n         transcricao_erro = coalesce(transcricao_erro, 'desistiu apos 3 tentativas')\n   where transcricao_status = 'pendente'\n     and transcricao_tentativas >= 3\n  returning 1\n),\nalvo as (\n  select m.id\n    from wakeclub.mensagens m\n   where m.transcricao_status = 'pendente'\n     and m.evolution_msg_id is not null\n     and m.transcricao_tentativas < 3\n   order by m.enviada_em desc\n   limit 5\n   for update skip locked\n)\nupdate wakeclub.mensagens m\n   set transcricao_status = 'transcrevendo',\n       transcricao_tentativas = m.transcricao_tentativas + 1,\n       transcrito_em = now()\n  from alvo a\n where m.id = a.id\nreturning m.id as mensagem_id, m.lead_id, m.evolution_msg_id, m.direcao,\n          to_char(m.enviada_em at time zone 'America/Sao_Paulo', 'DD/MM HH24:MI') as enviada_em_br;",
        "options": {
          "queryBatching": "single"
        }
      },
      "id": "b01a7e05-8a0f-40ff-a0da-078c7f1570f6",
      "name": "Reivindicar audios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -16,
        128
      ],
      "credentials": {
        "postgres": {
          "id": "3hUb94vSssNviUYu",
          "name": "wakeclubcrm - postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config da instancia').first().json.evolution_url }}/chat/getBase64FromMediaMessage/{{ $('Config da instancia').first().json.instancia }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: { key: { id: $json.evolution_msg_id } }, convertToMp4: false }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "11880137-c76b-4192-982f-89915837a3cc",
      "name": "Baixar audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        208,
        128
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "yniZfhH31bjuZigh",
          "name": "evolutionAgenciaNova Global Api KEy"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update wakeclub.mensagens\n   set transcricao_status = case\n         when transcricao_tentativas >= 3 then 'falhou'\n         else 'pendente' end,\n       transcricao_erro = left($2::text, 500)\n where id = $1::uuid\nreturning id as mensagem_id, transcricao_status, transcricao_tentativas, transcricao_erro;",
        "options": {
          "queryReplacement": "={{ [$json.mensagem_id || $('Reivindicar audios').item.json.mensagem_id, $json.error ? String($json.error.message || $json.error) : 'falha sem mensagem'] }}"
        }
      },
      "id": "68b91903-3e30-4a84-8047-c323190ed639",
      "name": "Marcar falha",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
