      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with t as (\n  update wakeclub.mensagens\n     set texto = nullif($2::text, ''),\n         transcricao_status = 'ok',\n         transcrito_em = now(),\n         transcricao_erro = null\n   where id = $1::uuid\n  returning lead_id, texto\n)\nupdate wakeclub.leads l\n   set qualificar_apos = now() + interval '2 minutes'\n  from t\n where l.id = t.lead_id\n   and l.opt_out = false\n   and l.sem_atendimento = false\nreturning l.id as lead_id, l.nome, t.texto as transcricao, l.qualificar_apos;",
        "options": {
          "queryReplacement": "={{ [$('Reivindicar audios').item.json.mensagem_id, $json.text] }}"
        }
      },
      "id": "29d9bd7c-10e0-4284-8ac1-c3120d7da2a8",
      "name": "Gravar transcricao",
